MODEL=gemini-2.5-flash
LOG_LEVEL=info

# Gemini: use API key (set one or both; google-genai prefers GOOGLE_API_KEY if both set)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional: Vertex AI instead of API key (do not set both modes at once)
# GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Monday of the sprint week (used in calendar agent scheduling hints)
SPRINT_WEEK_START=2026-04-07

# Google Calendar OAuth (run scripts/get_refresh_token.py once to get these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# GitHub (for mcp_push_github)
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo

# ── Phase 2: pick ONE persistence mode ───────────────────────────────────────
#
# A) AlloyDB (same pattern as omnexis-repo — AsyncConnector + IAM-friendly).
#    Requires Application Default Credentials (Cloud Shell: built-in; Cloud Run: SA).
#    If all variables below are set, they take priority over DATABASE_URL.
#
# ALLOYDB_CLUSTER=your-cluster-id
# ALLOYDB_INSTANCE=your-primary-instance-id
# ALLOYDB_DATABASE=your-db-name
# ALLOYDB_USER=your-db-user
# ALLOYDB_PASSWORD=your-db-password
#
# B) Generic Postgres URL (e.g. Cloud SQL Auth Proxy on localhost):
# DATABASE_URL=postgresql+pg8000://USER:PASSWORD@127.0.0.1:5432/DBNAME
#
# Omit both A and B for in-memory notes only.

# Optional: GCS bucket for artifacts
# GCS_BUCKET_NAME=your-bucket

# Azure DevOps — fill in after creating a PAT with Work Items (Read & write)
AZURE_DEVOPS_ORG=your-organization-name
AZURE_DEVOPS_PROJECT=your-project-name
AZURE_DEVOPS_PAT=your-personal-access-token
# Work item type must exactly match your project's process template.
# Common values: "Issue" (Basic), "User Story" (Agile), "Product Backlog Item" (Scrum)
AZURE_DEVOPS_WORK_ITEM_TYPE=Issue
